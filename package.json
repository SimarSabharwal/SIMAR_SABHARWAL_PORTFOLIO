{
  "name": "simar-portfolio",
  "version": "1.0.0",
  "description": "Simar Sabharwal — Full-Stack Developer Portfolio",
  "main": "dist/server.js",
  "scripts": {
    "build:client": "esbuild src/client/app.ts --bundle --outfile=public/js/app.js --target=es2020 --format=iife",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "dev": "concurrently \"tsx watch src/server.ts\" \"esbuild src/client/app.ts --bundle --outfile=public/js/app.js --target=es2020 --format=iife --watch\"",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
