{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/Simar_Sabharwal_Resume.pdf",
      "dest": "/public/Simar_Sabharwal_Resume.pdf"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
